<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_travel" model="ir.module.category">
        <field name="name">Travel Agency</field>
        <field name="sequence">50</field>
    </record>

    <record id="group_travel_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_category_travel"/>
    </record>

    <record id="group_travel_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_category_travel"/>
        <field name="implied_ids" eval="[(4, ref('group_travel_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>